# Configuración de Gmail SMTP para envío de cotizaciones (Orma Logistics)
# Replicado del esquema de integración de Asiel

# Cuenta de Gmail emisora
GMAIL_USER=productibot@gmail.com

# Contraseña de aplicación de Google (16 caracteres, generada en tu cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones)
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres

# Correos destinatarios que recibirán las cotizaciones (separados por coma)
NOTIFICATION_EMAIL=ark2784@gmail.com, productibot@gmail.com, ormalogistics@gmail.com, merida@ormalogistics.com
